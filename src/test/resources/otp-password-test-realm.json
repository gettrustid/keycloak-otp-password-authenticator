{
  "realm": "otp-password-test",
  "enabled": true,
  "sslRequired": "none",
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "alice-password",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "test-client",
      "enabled": true,
      "publicClient": false,
      "secret": "test-secret",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "authenticationFlows": [
    {
      "alias": "otp-password-authenticator",
      "description": "Direct grant flow with OTP/password authenticator",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "direct-grant-validate-username",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "otppasswordauthenticator",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticatorConfig": "otp-service-config"
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "otp-service-config",
      "config": {
        "otp-validation-service-url": "http://host.testcontainers.internal:18089/api/validateOtp"
      }
    }
  ],
  "browserFlow": "browser",
  "directGrantFlow": "otp-password-authenticator"
}
